// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Company {
  company_id              Int               @id @default(autoincrement())
  company_name            String
  registration_number     String            @unique
  Password                String
  business_type           String
  number_of_employees     Int?
  year_established        Int?
  company_description     String?
  created_at              DateTime          @default(now())
  industry_id             Int?
  location_id             Int?
  industry                Industry?         @relation(fields: [industry_id], references: [industry_id])
  location                Location?         @relation(fields: [location_id], references: [location_id])
  matches                 CompanyMatches[]  @relation("Company1")
  matched_with            CompanyMatches[]  @relation("Company2")
  products                CompanyProducts[]
  regions                 CompanyRegions[]
  targets                 CompanyTargets[]  @relation("SourceCompany")
  target_of               CompanyTargets[]  @relation("TargetCompany")
  notifications           Notification[]    @relation("CompanyNotifications")
  triggered_notifications Notification[]    @relation("RelatedCompanyNotifications")
}

model Industry {
  industry_id   Int       @id @default(autoincrement())
  industry_name String    @unique
  companies     Company[]
}

model Location {
  location_id Int       @id @default(autoincrement())
  country     String
  companies   Company[]
}

model Product {
  product_id   Int               @id @default(autoincrement())
  product_name String            @unique
  companies    CompanyProducts[]
}

model CompanyProducts {
  company_id Int
  product_id Int
  company    Company @relation(fields: [company_id], references: [company_id])
  product    Product @relation(fields: [product_id], references: [product_id])

  @@id([company_id, product_id])
}

model Region {
  region_id   Int              @id @default(autoincrement())
  region_name String           @unique
  companies   CompanyRegions[]
}

model CompanyRegions {
  company_id Int
  region_id  Int
  company    Company @relation(fields: [company_id], references: [company_id])
  region     Region  @relation(fields: [region_id], references: [region_id])

  @@id([company_id, region_id])
}

model CompanyTargets {
  source_company_id Int
  target_company_id Int
  status            String?  @default("pending")
  notes             String?
  created_at        DateTime @default(now())
  source            Company  @relation("SourceCompany", fields: [source_company_id], references: [company_id])
  target            Company  @relation("TargetCompany", fields: [target_company_id], references: [company_id])

  @@id([source_company_id, target_company_id])
}

model CompanyMatches {
  company1_id Int
  company2_id Int
  matched_at  DateTime @default(now())
  match_type  String?
  company1    Company  @relation("Company1", fields: [company1_id], references: [company_id])
  company2    Company  @relation("Company2", fields: [company2_id], references: [company_id])

  @@id([company1_id, company2_id])
}

model Notification {
  notification_id    Int      @id @default(autoincrement())
  company_id         Int
  type               String
  message            String?
  related_company_id Int?
  created_at         DateTime @default(now())
  is_read            Boolean  @default(false)
  company            Company  @relation("CompanyNotifications", fields: [company_id], references: [company_id])
  related_company    Company? @relation("RelatedCompanyNotifications", fields: [related_company_id], references: [company_id])

  @@unique([company_id, related_company_id, type])
}

model User {
  id            String   @id @default(uuid())
  name          String
  company       String
  email         String   @unique
  passwordHash  String
  country       String?
  industry      String?
  tradeType     TradeType @default(BOTH)
  verified      Boolean  @default(false)
  iecNumber     String?  //Importer Exporter Code
  abnNumber     String?  // Australia: ABN
  gstNumber     String?  // GST registration
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  registrations Registration[]
  matchesAsA    ScheduledMatch[] @relation("UserA")
  matchesAsB    ScheduledMatch[] @relation("UserB")
  outcomes      MatchOutcome[]
  messages      LobbyMessage[]
}

enum TradeType {
  IMPORTER
  EXPORTER
  BOTH
}


model Event {
  id                    String      @id @default(uuid())
  title                 String
  industry              String
  description           String?
  eventDate             DateTime
  status                EventStatus @default(UPCOMING)
  totalRounds           Int         @default(12)
  roundDurationSeconds  Int         @default(180)
  breakDurationSeconds  Int         @default(120)
  currentRound          Int         @default(0)
  createdAt             DateTime    @default(now())

  registrations  Registration[]
  matches        ScheduledMatch[]
  messages       LobbyMessage[]
}

enum EventStatus {
  UPCOMING
  LIVE
  CLOSED
}

model Registration {
  id                 String             @id @default(uuid())
  userId             String
  eventId            String
  offering           String?
  targetMarkets      String[]
  sessionPreference  SessionPreference  @default(FULL_DAY)
  status             UserEventStatus    @default(CONNECTED)
  registeredAt       DateTime           @default(now())

  user   User  @relation(fields: [userId], references: [id])
  event  Event @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
}

enum SessionPreference {
  FULL_DAY
  MORNING
  AFTERNOON
}

enum UserEventStatus {
  CONNECTED    // in lobby, not yet in queue
  WAITING      // sitting in Redis queue
  MATCHED      // partner found, room being created
  IN_MEETING   // inside Twilio video room
  POST_MATCH   // filling out post-match card
  DONE         // finished all rounds
}


model ScheduledMatch {
  id                  String      @id @default(uuid())
  eventId             String
  userAId             String
  userBId             String
  roundNumber         Int?
  compatibilityScore  Int?
  twilioRoomName      String?
  startedAt           DateTime?
  endedAt             DateTime?
  createdAt           DateTime    @default(now())

  event    Event          @relation(fields: [eventId], references: [id])
  userA    User           @relation("UserA", fields: [userAId], references: [id])
  userB    User           @relation("UserB", fields: [userBId], references: [id])
  outcomes MatchOutcome[]
}

model MatchOutcome {
  id        String   @id @default(uuid())
  matchId   String
  userId    String
  decision  Decision
  notes     String?
  rating    Int?
  createdAt DateTime @default(now())

  match  ScheduledMatch @relation(fields: [matchId], references: [id])
  user   User           @relation(fields: [userId], references: [id])

  @@unique([matchId, userId])
}

enum Decision {
  YES
  NO
  MAYBE
}

model LobbyMessage {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  message   String
  createdAt DateTime @default(now())

  event  Event @relation(fields: [eventId], references: [id])
  user   User  @relation(fields: [userId], references: [id])
}